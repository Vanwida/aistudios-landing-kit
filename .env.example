# Copy this file to `.env` only if Claude asks you to, and paste the lines yourself.
# `.env` is never committed, never deployed, and Claude never reads or writes it.

# Optional: Vercel token, only if browser login is not possible on this machine.
# VERCEL_TOKEN=

# Optional: form endpoint (Formspree / Web3Forms) — see launch-essentials skill.
# PUBLIC_FORM_ENDPOINT=
